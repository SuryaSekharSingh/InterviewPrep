<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/edge_primary_soft">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape>
                    <solid android:color="@color/edge_primary_soft"/>
                    <stroke android:width="1dp" android:color="@color/edge_primary"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/edge_surface"/>
                    <stroke android:width="1dp" android:color="@color/edge_border"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
