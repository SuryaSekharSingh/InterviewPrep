<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:id="@+id/screen" android:orientation="vertical" android:paddingStart="@dimen/edge_screen_horizontal" android:paddingEnd="@dimen/edge_screen_horizontal" android:paddingTop="24dp" android:paddingBottom="32dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/edge_ink" android:textSize="28sp" android:textStyle="bold" android:letterSpacing="-0.02" android:accessibilityHeading="true"/>
  <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:textColor="@color/edge_muted" android:textSize="15sp" android:lineSpacingExtra="2dp"/>
  <LinearLayout android:id="@+id/body" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <ProgressBar android:id="@+id/loading" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone"/>
  <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:textColor="@color/edge_error" android:background="@color/edge_surface" android:textSize="14sp" android:lineSpacingExtra="2dp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
 </LinearLayout>
</ScrollView>
